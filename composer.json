{
    "name": "trackportal/app",
    "description": "TrackPortal — persistenza via Doctrine ORM + DBAL",
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^4.4",
        "doctrine/orm": "^3.6",
        "dompdf/dompdf": "^3.0",
        "phpmailer/phpmailer": "^6.9",
        "smarty/smarty": "^5.8",
        "symfony/cache": "^7.4"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "classmap": [
            "Control/",
            "Entity/",
            "Foundation/",
            "View/"
        ]
    }
}
